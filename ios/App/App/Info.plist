<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>NightFlow</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- 딥링크 / OAuth 콜백 URL 스킴 -->
	<!-- ⚠️ 구글 iOS Client ID 발급 후 reversed client id로 placeholder 교체 필수 -->
	<!-- 예: 288156738643-XXXXXXXX.apps.googleusercontent.com → com.googleusercontent.apps.288156738643-XXXXXXXX -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>kr.nightflow.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nightflow</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>kr.nightflow.app.kakao</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao05e4bc59b65a9accadeb923e263e2212</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>kr.nightflow.app.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID</string>
			</array>
		</dict>
	</array>

	<!-- Kakao Native App Key (AppDelegate에서 KakaoSDK.initSDK 호출 시 참조) -->
	<key>KAKAO_APP_KEY</key>
	<string>05e4bc59b65a9accadeb923e263e2212</string>

	<!-- Kakao 앱 간 호출 허용 스킴 (kakaotalk 앱 깔린 경우 네이티브 로그인 우선) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakao05e4bc59b65a9accadeb923e263e2212</string>
		<string>kakaokompassauth</string>
		<string>storykompassauth</string>
		<string>kakaolink</string>
		<string>storylink</string>
		<string>kakaotalk</string>
	</array>

	<!-- 푸시 알림 백그라운드 수신 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- 권한 요청 메시지 -->
	<key>NSCameraUsageDescription</key>
	<string>프로필 사진 등록에 카메라를 사용합니다.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>프로필 사진 등록에 사진 라이브러리를 사용합니다.</string>

	<!-- 네트워크: Capacitor WebView 내부 컨텐츠만 cleartext 허용 (외부 도메인 접근은 HTTPS 강제) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>

	<!-- 세로 모드 전용 (클럽 앱) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
